# Runtime
NODE_ENV=development
PORT=3001

# Public app URL (used in invite emails)
APP_BASE_URL=http://localhost:5173

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Frontend (optional; leave empty to use same-origin / Vite proxy)
VITE_API_BASE_URL=

# Storage: local | s3
# Production must use s3 with real credentials (no placeholders).
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
LOCAL_DATA_DIR=./data

# S3-compatible object storage (required when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for MinIO/R2/etc
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Email: console | resend
# Production must use resend with a real API key and from-address.
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM=Northline Applications <applications@your-domain.com>
NOTIFY_EMAIL=operations@your-domain.com

# Upload limits
MAX_FILE_BYTES=10485760
MAX_TOTAL_UPLOAD_BYTES=41943040
MAX_FILES=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30
