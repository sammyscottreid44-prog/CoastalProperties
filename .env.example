# Runtime
NODE_ENV=development
PORT=3001

# Public app URL (used in invite emails)
APP_BASE_URL=http://localhost:5173

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

VITE_API_BASE_URL=

# Storage: local | s3
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
LOCAL_DATA_DIR=./data

S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Email: resend | smtp | console
# Submissions notify NOTIFY_EMAIL (never shown to applicants).
EMAIL_DRIVER=resend
RESEND_API_KEY=
EMAIL_FROM=CoastApply <onboarding@resend.dev>
NOTIFY_EMAIL=sammyscottreid44@gmail.com

# Optional SMTP (e.g. Gmail App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

MAX_FILE_BYTES=10485760
MAX_TOTAL_UPLOAD_BYTES=41943040
MAX_FILES=24
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30
